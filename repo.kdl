schema-version 1
name "Proving Ground"

// renovate: datasource=github-releases depName=tectonic-os/tectonic
tect-version "0.3.3"

workflows at="12:30" {
    base-sig-probe
    build
    build-disk
    cleanup-registry
    smoke-test
}

sources {
    tectonic-os {
        pin {
            manual "the collection publishes no releases to track"
            version "d62198faa1588f7e1ce24e75a06d37512865b81c"
            url "https://github.com/tectonic-os/modules/archive/{version}.tar.gz"
            sha256 "a82171c6c1016b03382925e1ba1dfc81abd7c7cdde119ab0ebb055c89a7e146d"
        }
    }
}

audit {
    enforce #true
}

default-image "proving-ground"
