schema-version 1
name "Proving Ground"

// renovate: datasource=github-releases depName=tectonic-os/tectonic
tect-version "0.2.1"

workflows at="12:30" {
    base-sig-probe
    build
    build-disk
    cleanup-registry
    smoke-test
}

sources {
    tectonic-os {
        pin {
            manual "the collection publishes no releases to track"
            version "d1a471d9c326dda031f86e00755a274e61b22a8c"
            url "https://github.com/tectonic-os/modules/archive/{version}.tar.gz"
            sha256 "c66efe5c814a2a6e19fd645010de073b3df4fe3675ac946533a95ac1b23095db"
        }
    }
}

audit {
    enforce #true
}

default-image "proving-ground"
