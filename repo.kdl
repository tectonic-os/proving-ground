schema-version 1
name "Proving Ground"

// renovate: datasource=github-releases depName=tectonic-os/tectonic
tect-version "0.6.4" sha256="d10fa8afa2afb8960780ae43a1cad87d3a5e8a0982de2e298ecf944cfcdcb2fd"

workflows at="12:30" {
    base-sig-probe
    build
    build-disk
    cleanup-registry
    smoke-test
}

sources {
    tectonic-os {
        pin {
            manual "the collection publishes no releases to track"
            version "5ac1c4da0f0accf5a1ca6c28a6fe954e1d643ea9"
            url "https://github.com/tectonic-os/modules/archive/{version}.tar.gz"
            sha256 "d615a424688f27c0c631fec5aaafa02859d76a445455d8ab2909d4c794e50456"
        }
    }
}

audit {
    enforce #true
}

default-image "proving-ground"
