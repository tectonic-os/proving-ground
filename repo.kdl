schema-version 1
name "Proving Ground"

// renovate: datasource=github-releases depName=tectonic-os/tectonic
tect-version "0.4.2"

workflows at="12:30" {
    base-sig-probe
    build
    build-disk
    cleanup-registry
    smoke-test
}

sources {
    tectonic-os {
        pin {
            manual "the collection publishes no releases to track"
            version "adb72e091ddf40c6cf65b150498231c437b30d1b"
            url "https://github.com/tectonic-os/modules/archive/{version}.tar.gz"
            sha256 "9b1fc23a2269882bd5dde97264abb3193d9fc06b8f5c06294b10a5092a70f153"
        }
    }
}

audit {
    enforce #true
}

default-image "proving-ground"
