schema-version 1
name "Proving Ground"

// renovate: datasource=github-releases depName=tectonic-os/tectonic
tect-version "0.3.5"

workflows at="12:30" {
    base-sig-probe
    build
    build-disk
    cleanup-registry
    smoke-test
}

sources {
    tectonic-os {
        pin {
            manual "the collection publishes no releases to track"
            version "7582148f693ec971dca980f940f140b5d5351b48"
            url "https://github.com/tectonic-os/modules/archive/{version}.tar.gz"
            sha256 "171373f3d960db45da171ebe8d9fa5182f2c8941e7565aef9ee46f269ee91290"
        }
    }
}

audit {
    enforce #true
}

default-image "proving-ground"
