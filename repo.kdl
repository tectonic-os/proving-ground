schema-version 1
name "Proving Ground"

// renovate: datasource=github-releases depName=tectonic-os/tectonic
tect-version "0.3.0"

workflows at="12:30" {
    base-sig-probe
    build
    build-disk
    cleanup-registry
    smoke-test
}

sources {
    tectonic-os {
        pin {
            manual "the collection publishes no releases to track"
            version "a50e304942ce19f382b05ccf504bf8e8d29812bd"
            url "https://github.com/tectonic-os/modules/archive/{version}.tar.gz"
            sha256 "f37f8ac48c4788b39726daee0c4067d3c0d396c015584e4029a87c7fe9abb577"
        }
    }
}

audit {
    enforce #true
}

default-image "proving-ground"
